# RestartHER - Environment Variables
# SAP Hackathon - AI Inclusive Workforce

# Server Port
PORT=4004

# Google Gemini Free API Key
# Obtain a free key from Google AI Studio: https://aistudio.google.com/
# If left empty, RestartHER automatically uses the built-in offline-safe AI engine!
GEMINI_API_KEY=

# SAP BTP Cloud Foundry Environment (Optional / Production)
SAP_BTP_DESTINATION=
SAP_TIH_ENDPOINT=
